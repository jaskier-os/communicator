# Copy this file to .env and fill in the values for your environment.
# Never commit a real .env -- it is gitignored.

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
# Port the HTTP server listens on.
PORT=3000
# Bind address. 0.0.0.0 listens on all interfaces; 127.0.0.1 is local-only.
HOST=0.0.0.0
# Runtime environment: development | production | test
NODE_ENV=development
# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Comma-separated list of API keys that clients must present (x-api-key header
# or Authorization: Bearer <key>). Generate strong random values.
API_KEYS=your-api-key-here

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins, or * for all.
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ----------------------------------------------------------------------------
# LLM Provider Selection
# ----------------------------------------------------------------------------
# Which backend to route prompts to:
#   custom     - an OpenAI-compatible HTTP API (e.g. vLLM, Yandex Cloud LLM)
#   claude-cli - the local Claude Code CLI binary
#   gateway    - model-config-based routing (see models.config.json)
LLM_PROVIDER=custom

# ----------------------------------------------------------------------------
# Custom LLM API (required when LLM_PROVIDER=custom)
# ----------------------------------------------------------------------------
# Base URL of the OpenAI-compatible upstream API.
CUSTOM_API_URL=http://localhost:8000
# API key for the upstream API.
CUSTOM_API_KEY=your-custom-api-key
# Model identifier to request from the upstream API.
CUSTOM_API_MODEL=your-model-name
# Extra headers as a JSON object string, e.g. {"x-folder-id":"..."}
CUSTOM_API_HEADERS={}

# ----------------------------------------------------------------------------
# Claude CLI (used when LLM_PROVIDER=claude-cli)
# ----------------------------------------------------------------------------
# Command used to invoke the Claude Code CLI.
CLAUDE_CLI_COMMAND=claude --dangerously-skip-permissions

# ----------------------------------------------------------------------------
# Request handling
# ----------------------------------------------------------------------------
# Upstream request timeout in milliseconds.
REQUEST_TIMEOUT_MS=3600000
# Enable streaming responses (true/false).
ENABLE_STREAMING=false

# ----------------------------------------------------------------------------
# OAuth token refresh side channel (optional; only for gateway oauth models)
# ----------------------------------------------------------------------------
# When using oauth-authenticated models, expired Claude OAuth tokens are
# refreshed by SSHing to a host that runs the upstream Claude CLI. If unset,
# the refresh side channel is disabled and an expired token simply fails.
# Hostname or IP of the host that performs the OAuth refresh.
REFRESH_SSH_HOST=
# SSH port (default 22).
REFRESH_SSH_PORT=22
# SSH user (default root).
REFRESH_SSH_USER=root
# Path to the private key used for the SSH side channel.
REFRESH_SSH_KEY=
# Optional known_hosts file. If set, strict host key checking is enabled.
REFRESH_SSH_KNOWN_HOSTS=

# ----------------------------------------------------------------------------
# Yandex Cloud VM Management (optional; only when YC_VM_ENABLED=true)
# ----------------------------------------------------------------------------
# Enable automatic start/stop of a Yandex Cloud GPU VM hosting the LLM.
YC_VM_ENABLED=false
# Yandex Cloud compute instance ID to manage.
YC_VM_INSTANCE_ID=your-vm-instance-id
# Path to the Yandex Cloud service account key JSON file (not committed).
YC_SERVICE_ACCOUNT_KEY_PATH=./yandex-cloud-key.json
# Health endpoint used to detect when the VM's LLM server is ready.
YC_VLLM_HEALTH_URL=http://your-vm-ip:8000/health
# Stop the VM when this process shuts down (true/false).
YC_VM_STOP_ON_SHUTDOWN=true
# Stop the VM after this many ms of inactivity.
YC_VM_IDLE_TIMEOUT_MS=300000
# Grace period in ms before forcing VM shutdown.
YC_VM_SHUTDOWN_GRACE_PERIOD_MS=30000

# ----------------------------------------------------------------------------
# Outbound Proxy (optional)
# ----------------------------------------------------------------------------
# If the upstream LLM API must be reached through a proxy, set these. The
# server and run.sh honor standard proxy env vars.
# HTTP_PROXY=http://127.0.0.1:10808/
# HTTPS_PROXY=http://127.0.0.1:10808/
# NO_PROXY=localhost,127.0.0.0/8,::1
